<script>
    function panthBannerSlider(total, config) {
        const reduced = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
        return {
            current: 0,
            total: total,
            timer: null,
            touchStartX: 0,
            config: config,
            focused: false,
            hovered: false,
            reducedMotion: reduced,
            userPaused: !!config.autoplay && reduced,

            init() {
                this.startAutoplay();
                const warm = () => setTimeout(() => {
                    this.$el.querySelectorAll('.panth-banner-slide img[loading="lazy"]').forEach((img) => {
                        img.loading = 'eager';
                    });
                }, 1500);
                if (document.readyState === 'complete') {
                    warm();
                } else {
                    window.addEventListener('load', warm, { once: true });
                }
            },

            isRunning() {
                return this.timer !== null;
            },

            startAutoplay() {
                this.stopAutoplay();
                if (!this.config.autoplay || this.userPaused || this.focused || this.hovered || this.total < 2) {
                    return;
                }
                this.timer = setInterval(() => this.next(false), this.config.autoplaySpeed || 5000);
            },

            stopAutoplay() {
                if (this.timer) {
                    clearInterval(this.timer);
                    this.timer = null;
                }
            },

            togglePlay() {
                this.userPaused = !this.userPaused;
                if (this.userPaused) {
                    this.stopAutoplay();
                } else {
                    this.focused = false;
                    this.startAutoplay();
                }
            },

            focusPause() {
                this.focused = true;
                this.stopAutoplay();
            },

            focusResume(event) {
                if (event.relatedTarget && this.$el.contains(event.relatedTarget)) return;
                this.focused = false;
                this.startAutoplay();
            },

            pause() {
                if (!this.config.pauseOnHover) return;
                this.hovered = true;
                this.stopAutoplay();
            },

            resume() {
                if (!this.config.pauseOnHover) return;
                this.hovered = false;
                this.startAutoplay();
            },

            next(user) {
                if (this.config.loop || this.current < this.total - 1) {
                    this.current = (this.current + 1) % this.total;
                } else if (!user) {
                    this.stopAutoplay();
                }
                if (user) this.restart();
            },

            prev(user) {
                if (this.config.loop || this.current > 0) {
                    this.current = (this.current - 1 + this.total) % this.total;
                }
                if (user) this.restart();
            },

            restart() {
                if (this.isRunning()) this.startAutoplay();
            },

            keyNav(event, direction) {
                const target = event.target;
                const tag = target && target.tagName ? target.tagName.toLowerCase() : '';
                if (tag === 'input' || tag === 'textarea' || tag === 'select' || (target && target.isContentEditable)) {
                    return;
                }
                event.preventDefault();
                direction > 0 ? this.next(true) : this.prev(true);
            },

            goTo(index) {
                this.current = index;
                this.restart();
            },

            touchStart(e) {
                this.touchStartX = e.changedTouches[0].screenX;
            },

            touchEnd(e) {
                const diff = this.touchStartX - e.changedTouches[0].screenX;
                if (Math.abs(diff) > 50) {
                    diff > 0 ? this.next(true) : this.prev(true);
                }
            },

            destroy() {
                this.stopAutoplay();
            }
        };
    }
</script>
